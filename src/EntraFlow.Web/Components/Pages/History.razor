@page "/history"
@attribute [Authorize]
@inject IAuditLog Audit

<PageTitle>History · Entra-Flow</PageTitle>

<h1>Run history</h1>
<p class="text-muted">Every provisioning run is recorded for audit.</p>

@if (_entries is null)
{
    <p>Loading…</p>
}
else if (_entries.Count == 0)
{
    <p class="text-muted">No runs yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>When (UTC)</th><th>User</th><th>Source</th>
                    <th>Valid</th><th>Rejected</th><th>Sink</th><th>Mode</th><th>Run</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in _entries)
                {
                    <tr>
                        <td>@e.Timestamp.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@e.User</td>
                        <td>@e.SourceName</td>
                        <td><span class="badge bg-success">@e.ValidCount</span></td>
                        <td><span class="badge bg-danger">@e.ErrorCount</span></td>
                        <td>@e.SinkMode</td>
                        <td>
                            <span class="badge @(e.DryRun ? "bg-info" : "bg-danger")">
                                @(e.DryRun ? "dry-run" : "LIVE")
                            </span>
                        </td>
                        <td class="text-muted small">@e.Id</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<AuditEntry>? _entries;

    protected override async Task OnInitializedAsync()
    {
        _entries = await Audit.RecentAsync();
    }
}
